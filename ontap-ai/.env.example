# Lấy trong Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Lấy tại console.anthropic.com > API Keys (KHÔNG thêm NEXT_PUBLIC_ phía trước)
ANTHROPIC_API_KEY=sk-ant-...

# Tên model AI dùng để tạo đề (có thể đổi sang model khác)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Số lần tạo đề bằng AI tối đa mỗi người mỗi ngày (kiểm soát chi phí)
DAILY_AI_LIMIT=10
